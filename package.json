{
  "name": "elc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vp -C apps/web dev",
    "dev:marketing": "vp run --filter @elc/marketing dev",
    "build": "vp run typecheck && vp -C apps/web build && vp run --filter @elc/marketing build",
    "typecheck": "tsc -b && vp run --filter @elc/marketing typecheck",
    "lint": "vp lint .",
    "format": "vp fmt .",
    "preview": "vp -C apps/web preview",
    "db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts",
    "db:migrate": "wrangler d1 migrations apply elc-local --local --config apps/api/wrangler.jsonc --persist-to .wrangler/state",
    "prepare": "vp config",
    "setup:local": "node scripts/setup-local.mjs",
    "auth:generate": "auth generate --config apps/api/src/auth/schema-cli.ts --adapter drizzle --dialect sqlite --output apps/api/src/db/auth-schema.ts --yes",
    "verify:local-auth": "node scripts/verify-local-auth.mjs",
    "verify:local-ticketing": "node scripts/verify-local-ticketing.mjs",
    "test:backup": "node --test scripts/backup-core.test.mjs scripts/backup-sql.test.mjs",
    "verify:backup": "vp run test:backup && vp test --config scripts/backup-vitest.config.mjs",
    "backup:database": "node scripts/backup-database.mjs",
    "restore:database": "node scripts/restore-database.mjs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "auth": "1.7.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "globals": "^17.12.0",
    "miniflare": "5.20260911.0-alpha",
    "node-gyp": "12.3.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.3.1",
    "vite-plus": "^0.3.1",
    "wrangler": "^4.131.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  }
}
