EXPO_PUBLIC_APP_ENVIRONMENT=local
# Physical devices need this computer's reachable LAN origin; localhost is for the iOS simulator.
EXPO_PUBLIC_API_ORIGIN=http://localhost:5173
# Preview/demo builds must receive their deployment's PUBLIC offline key pin.
# Local builds read .wrangler/offline-public-key.json after vp run setup:local.
EXPO_PUBLIC_OFFLINE_PUBLIC_KEY_JSON=
