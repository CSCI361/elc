---
import Arrow from "./Arrow.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
import { copy, languageLinks, type Locale } from "../content/copy"
import { appLink, resolveAppOrigin } from "../lib/app-links"

interface Props { locale: Locale }

const { locale } = Astro.props
const text = copy[locale]
const appOrigin = resolveAppOrigin(import.meta.env.PUBLIC_APP_ORIGIN, import.meta.env.PUBLIC_DEPLOYMENT_ENV)
const applicationUrl = appLink(appOrigin, locale)
const homeUrl = languageLinks.find((language) => language.locale === locale)?.href ?? "/"
---

<BaseLayout locale={locale} title={text.title} description={text.description}>
  <a class="skip-link" href="#main">{text.skip}</a>

  <header class="site-header page-width">
    <a class="wordmark" href={homeUrl} aria-label={text.home}>elc<span aria-hidden="true">.</span></a>
    <nav class="main-nav" aria-label={text.navigation}>
      <a href="#workflow">{text.navWorkflow}</a>
      <a href="#attendees">{text.navAttendees}</a>
      <a href="#demo">{text.navDemo}</a>
    </nav>
    <nav class="language-nav" aria-label={text.language}>
      {languageLinks.map((language) => (
        <a
          href={language.href}
          lang={language.locale}
          hreflang={language.locale}
          aria-label={language.name}
          aria-current={language.locale === locale ? "page" : undefined}
        >{language.label}</a>
      ))}
    </nav>
  </header>

  <main id="main">
    <section class="hero page-width" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{text.eyebrow}</p>
        <h1 id="hero-title">{text.heroLineOne}<br /><span>{text.heroLineTwo}</span></h1>
        <p class="hero-description">{text.heroDescription}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={applicationUrl}>{text.openApp}<Arrow /></a>
          <a class="text-link" href="#workflow">{text.heroSecondary}<span aria-hidden="true">↘</span></a>
        </div>
        <p class="hero-note">{text.heroNote}</p>
      </div>

      <figure class="ticket-illustration">
        <div class="orbit orbit-one" aria-hidden="true"></div>
        <div class="orbit orbit-two" aria-hidden="true"></div>
        <div class="ticket-shadow" aria-hidden="true"></div>
        <div class="sample-ticket" aria-hidden="true">
          <div class="ticket-top">
            <span class="ticket-logo">elc.</span>
            <span class="ticket-label">{text.ticketEyebrow}</span>
          </div>
          <div class="ticket-middle">
            <span class="ticket-pill">{text.ticketKind}</span>
            <p class="ticket-event">{text.ticketTitle}</p>
            <div class="ticket-guest">
              <span>{text.ticketFor}</span>
              <strong>{text.ticketHolder}</strong>
            </div>
          </div>
          <div class="ticket-tear"><span></span><span></span></div>
          <div class="ticket-bottom">
            <div class="qr-symbol">
              <svg viewBox="0 0 64 64" width="76" height="76" fill="none" focusable="false">
                <rect x="3" y="3" width="20" height="20" rx="2" stroke="currentColor" stroke-width="5" />
                <rect x="41" y="3" width="20" height="20" rx="2" stroke="currentColor" stroke-width="5" />
                <rect x="3" y="41" width="20" height="20" rx="2" stroke="currentColor" stroke-width="5" />
                <path d="M11 11h4v4h-4zM49 11h4v4h-4zM11 49h4v4h-4zM32 3v15M31 30h12v12H31zM52 32h9v9M33 51v10h10M52 50v11h9" fill="currentColor" stroke="currentColor" stroke-width="3" />
              </svg>
            </div>
            <div><span class="ticket-bottom-label">{text.ticketFormat}</span><span class="ticket-shortline"></span><span class="ticket-shortline shorter"></span></div>
            <span class="ticket-index">01</span>
          </div>
        </div>
        <div class="ticket-stamp" aria-hidden="true"><span>✳</span>{text.ticketStamp}</div>
        <figcaption>{text.ticketCaption}</figcaption>
      </figure>
    </section>

    <div class="capability-strip">
      <ul class="page-width">{text.strip.map((item) => <li><span aria-hidden="true">✳</span>{item}</li>)}</ul>
    </div>

    <section class="section page-width" id="workflow" aria-labelledby="workflow-title">
      <div class="section-heading">
        <div><p class="eyebrow">{text.workflowEyebrow}</p><h2 id="workflow-title">{text.workflowTitle}</h2></div>
        <p class="section-description">{text.workflowDescription}</p>
      </div>
      <ol class="workflow-grid">
        {text.steps.map((step, index) => (
          <li>
            <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="attendee-section" id="attendees" aria-labelledby="attendees-title">
      <div class="page-width attendee-inner">
        <div class="attendee-heading">
          <p class="eyebrow">{text.attendeesEyebrow}</p>
          <h2 id="attendees-title">{text.attendeesTitle}</h2>
          <p class="section-description">{text.attendeesDescription}</p>
          <a class="text-link" href={applicationUrl}>{text.openApp}<Arrow /></a>
        </div>
        <ul class="attendee-features">
          {text.attendeeFeatures.map((feature, index) => (
            <li>
              <span class="feature-mark" aria-hidden="true">{index === 0 ? "↗" : index === 1 ? "▧" : "↔"}</span>
              <div><h3>{feature.title}</h3><p>{feature.description}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section page-width pricing-section" aria-labelledby="pricing-title">
      <div class="pricing-heading"><p class="eyebrow">{text.pricingEyebrow}</p><h2 id="pricing-title">{text.pricingTitle}</h2></div>
      <div class="pricing-options">
        <article class="price-option free-option">
          <h3>{text.freeTitle}</h3>
          <p class="price">0 <span>₸</span></p>
          <p class="price-label">{text.freeLabel}</p>
          <p class="price-description">{text.freeDescription}</p>
        </article>
        <article class="price-option paid-option">
          <h3>{text.paidTitle}</h3>
          <p class="price">5 000 <span>₸</span></p>
          <p class="price-label">{text.paidLabel}</p>
          <p class="price-description">{text.paidDescription}</p>
        </article>
      </div>
    </section>

    <section class="demo-section page-width" id="demo" aria-labelledby="demo-title">
      <div>
        <p class="eyebrow">{text.demoEyebrow}</p>
        <h2 id="demo-title">{text.demoTitle}</h2>
        <p>{text.demoDescription}</p>
        <p class="demo-status"><span aria-hidden="true"></span>{text.demoStatus}</p>
      </div>
      <a class="button button-light" href={applicationUrl}>{text.openApp}<Arrow /></a>
    </section>

    <section class="section page-width faq-section" aria-labelledby="faq-title">
      <h2 id="faq-title">{text.faqTitle}</h2>
      <div class="questions">
        {text.questions.map((question) => (
          <details>
            <summary>{question.question}<span aria-hidden="true">+</span></summary>
            <p>{question.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="site-footer page-width">
    <div><a class="wordmark" href={homeUrl} aria-label={text.home}>elc<span aria-hidden="true">.</span></a><p>{text.footerDescription}</p></div>
    <div class="footer-end"><p>{text.footerPrivacy}</p><a href="#top">{text.top}<span aria-hidden="true">↑</span></a></div>
  </footer>
</BaseLayout>
