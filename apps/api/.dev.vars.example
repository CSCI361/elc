# Generate a local random secret with `vp run setup:local` once configured.
AUTH_SECRET=
# Keep this 32-byte base64url key stable when rotating the auth secret.
TICKET_ENCRYPTION_KEY=
OFFLINE_SIGNING_PRIVATE_JWK=
OFFLINE_SIGNING_KEY_ID=
# Configure these only for their associated external acceptance checks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
GA4_PROPERTY_ID=
# JSON service-account credentials remain server-side.
GA4_SERVICE_ACCOUNT_JSON=
# Polar sandbox; docs/polar-preview-setup.md also copies these to the preview Worker.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Sandbox-only identifiers; the adapter never calls the production API.
POLAR_PRODUCT_ID=66720b47-54e1-453f-91a1-58f6a35cbd30
POLAR_ORGANIZATION_ID=
