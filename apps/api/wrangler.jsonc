{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "elc-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ENVIRONMENT": "local",
    "APP_ORIGIN": "http://localhost:5173",
    "EMAIL_FROM": "elc <noreply@example.invalid>",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elc-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "elc-local-files" },
    { "binding": "BACKUPS", "bucket_name": "elc-local-backups" },
  ],
  "queues": {
    "producers": [{ "binding": "DELIVERY", "queue": "elc-local-delivery" }],
    "consumers": [
      {
        "queue": "elc-local-delivery",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "elc-local-delivery-dlq",
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "SUPPORT", "class_name": "SupportCase" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SupportCase"] }],
}
